# Backend base URL the admin app talks to.
THUMBPAY_API_URL=http://localhost:3000

# Fingerprint reader (ZKTeco ZK9500 via the ZKFinger SDK).
# Optional: absolute path to the vendor library if it isn't on the system search path.
#   Windows: C:\Program Files\ZKFinger\libzkfp.dll
#   Linux:   /opt/zkfinger/libzkfp.so   (its folder must also be on LD_LIBRARY_PATH)
# THUMBPAY_ZKFINGER_LIB=

# Set to 1 to force the simulated reader even on Windows/Linux (demos without hardware).
# On macOS the reader is always simulated — ZKTeco ships no macOS driver.
# THUMBPAY_FORCE_SIMULATED_READER=
