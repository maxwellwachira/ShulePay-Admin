{
  "name": "thumbpay-admin",
  "version": "0.1.3",
  "private": true,
  "description": "ThumbPay Admin — desktop app for onboarding students, biometric enrollment, and reports.",
  "author": "ThumbPay",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "ke.thumbpay.admin",
    "productName": "ThumbPay Admin",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/zkfinger",
        "to": "zkfinger"
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "ThumbPay-Admin-Setup.${ext}",
      "perMachine": true,
      "include": "build-resources/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "maxwellwachira",
      "repo": "ShulePay-Admin",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
